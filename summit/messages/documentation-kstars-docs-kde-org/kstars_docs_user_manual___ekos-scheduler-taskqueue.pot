msgstr ""

#. +> trunk5
#: ../../user_manual/ekos-scheduler-taskqueue.rst:57
msgid "Templates come in two types:"
msgstr ""

#. +> trunk5
#: ../../user_manual/ekos-scheduler-taskqueue.rst:59
msgid "**System Templates**: Pre-built templates provided with KStars for common operations (park mount, enable cooling, etc.)"
msgstr ""

#. +> trunk5
#: ../../user_manual/ekos-scheduler-taskqueue.rst:60
msgid "**Templates**"
msgstr ""

#. +> trunk5
#: ../../user_manual/ekos-scheduler-taskqueue.rst:60
msgid "**User Templates**: Custom templates you create by selecting a device and specifying which property to set or evaluate, along with the target values and conditions"
msgstr ""

#. +> trunk5
#: ../../user_manual/ekos-scheduler-taskqueue.rst:63
msgid "Tasks are specific instances created from templates. When you add a template to the queue, you create a task by:"
