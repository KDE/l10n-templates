#, no-c-format
msgid "~/.config/kaichatrc"
msgstr ""

#. Tag: para
#. +> trunk6 stable6
#: index.docbook:536
#, no-c-format
msgid "The settings of the application."
msgstr ""

#. Tag: filename
#. +> trunk6 stable6
#: index.docbook:539
#, no-c-format
msgid "~/.local/share/kaichat/ai-database/"
msgstr ""

#. Tag: para
#. +> trunk6 stable6
#: index.docbook:540
#, no-c-format
msgid "The databases holding your chats and their messages. The exact location is shown on the <guilabel>Privacy</guilabel> page of the configuration dialog."
msgstr ""

#. Tag: para
#. +> trunk6 stable6
#: index.docbook:546
#, no-c-format
msgid "The configuration of your instances contains the API keys of the online services you use. Treat these files as you would treat a password."
msgstr ""

