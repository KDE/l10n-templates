#. Tag: title
#: index.docbook:41
#, no-c-format
msgid "Introduction"
msgstr ""

#. Tag: para
#: index.docbook:42
#, no-c-format
msgid ""
"&chessament; is a chess tournament manager. It supports individual Swiss-"
"system tournaments."
msgstr ""

#. Tag: para
#: index.docbook:45
#, no-c-format
msgid "Main features of &chessament;:"
msgstr ""

#. Tag: para
#: index.docbook:50
#, no-c-format
msgid "Registering players."
msgstr ""

#. Tag: para
#: index.docbook:53
#, no-c-format
